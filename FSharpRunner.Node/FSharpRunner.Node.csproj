<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FSharpRunner\CompileService.cs" Link="CompileService.cs" />
    <Compile Include="..\FSharpRunner\VirtualFileSystem.cs" Link="VirtualFileSystem.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\FSharpRunner\refs\*.dll" LogicalName="lib.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.400" />
  </ItemGroup>
</Project>
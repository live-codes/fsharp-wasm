<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.400" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="refs\*.dll" LogicalName="lib.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>